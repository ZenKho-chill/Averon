# ==================================================
# Averon — mẫu biến môi trường / environment template
# KHÔNG BAO GIỜ commit secret thật vào git.
# Copy file này thành .env rồi điền giá trị thật.
# EN: Never commit real secrets. Copy to .env and fill in.
# ==================================================

# --- Discord bot token (từ https://discord.com/developers/applications) ---
DISCORD_TOKEN=

# --- Môi trường chạy / runtime env: dev | prod | staging ---
# Core nạp config/<env>.yml theo biến này (xem CLAUDE.md §8)
AVERON_ENV=dev

# --- Database connection (nếu dùng shared/db) ---
# DB_URL=

# --- Logging override (tùy chọn) ---
# LOG_LEVEL=INFO
