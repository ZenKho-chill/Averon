{
  "name": "averon",
  "version": "0.3.0",
  "description": "A modular multi-language Discord bot / Discord bot đa chức năng theo hướng module hóa",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch core/src/bootstrap.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/core/src/bootstrap.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "new:module": "node scripts/new-module.mjs",
    "validate:config": "tsx scripts/validate-config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.0"
  }
}
