{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://averon.dev/schemas/core.schema.json",
  "title": "Averon core config",
  "type": "object",
  "required": ["app", "discord", "logging", "crash", "dev"],
  "properties": {
    "app": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
      }
    },
    "discord": {
      "type": "object",
      "required": ["intents"],
      "properties": {
        "token": { "type": "string" },
        "intents": {
          "type": "array",
          "items": { "type": "string", "enum": ["Guilds", "GuildMessages", "MessageContent", "GuildMembers", "GuildVoiceStates", "DirectMessages"] }
        },
        "guild_id": { "type": "string", "pattern": "^\\d+$" },
        "register_commands": {
          "type": "object",
          "properties": {
            "global": { "type": "boolean", "default": true },
            "guild": { "type": "boolean", "default": false },
            "user": { "type": "boolean", "default": false }
          }
        }
      }
    },
    "logging": {
      "type": "object",
      "required": ["level"],
      "properties": {
        "level": { "type": "string", "enum": ["DEBUG", "INFO", "WARN", "ERROR", "FATAL"] },
        "console_color": { "type": "boolean" },
        "file": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "dir": { "type": "string" },
            "max_size_mb": { "type": "number", "minimum": 1 },
            "keep_files": { "type": "number", "minimum": 1 }
          }
        }
      }
    },
    "crash": {
      "type": "object",
      "properties": {
        "max_failures": { "type": "number", "minimum": 1 },
        "fail_window_ms": { "type": "number", "minimum": 0 },
        "watchdog": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "max_restarts": { "type": "number", "minimum": 1 },
            "window_min": { "type": "number", "minimum": 1 }
          }
        }
      }
    },
    "dev": {
      "type": "object",
      "properties": {
        "hot_reload": { "type": "boolean" },
        "show_stacktrace": { "type": "boolean" }
      }
    }
  }
}
